#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D uEquirect;
layout(rgba16f, binding = 0) uniform writeonly imageCube uCube;

const float PI = 3.14159265359;

// OpenGL cube face conventions: layer 0..5 = +X, -X, +Y, -Y, +Z, -Z
vec3 CubeDirection(uvec3 id, float size) {
    vec2 uv = (vec2(id.xy) + 0.5) / size * 2.0 - 1.0;
    float u = uv.x, v = uv.y;
    switch (id.z) {
        case 0: return normalize(vec3(1.0, -v, -u));
        case 1: return normalize(vec3(-1.0, -v, u));
        case 2: return normalize(vec3(u, 1.0, v));
        case 3: return normalize(vec3(u, -1.0, -v));
        case 4: return normalize(vec3(u, -v, 1.0));
        default: return normalize(vec3(-u, -v, -1.0));
    }
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    ivec2 size = imageSize(uCube);
    if (id.x >= uint(size.x) || id.y >= uint(size.y)) return;

    vec3 d = CubeDirection(id, float(size.x));
    vec2 uv = vec2(atan(d.z, d.x) / (2.0 * PI) + 0.5, asin(clamp(d.y, -1.0, 1.0)) / PI + 0.5);
    vec3 color = min(textureLod(uEquirect, uv, 0.0).rgb, vec3(500.0)); // tame extreme sun texels
    imageStore(uCube, ivec3(id), vec4(color, 1.0));
}
