#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform samplerCube uEnv;
layout(rgba16f, binding = 0) uniform writeonly imageCube uOut;

const float PI = 3.14159265359;

vec3 CubeDirection(uvec3 id, float size) {
    vec2 uv = (vec2(id.xy) + 0.5) / size * 2.0 - 1.0;
    float u = uv.x, v = uv.y;
    switch (id.z) {
        case 0: return normalize(vec3(1.0, -v, -u));
        case 1: return normalize(vec3(-1.0, -v, u));
        case 2: return normalize(vec3(u, 1.0, v));
        case 3: return normalize(vec3(u, -1.0, -v));
        case 4: return normalize(vec3(u, -v, 1.0));
        default: return normalize(vec3(-u, -v, -1.0));
    }
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    ivec2 size = imageSize(uOut);
    if (id.x >= uint(size.x) || id.y >= uint(size.y)) return;

    vec3 N = CubeDirection(id, float(size.x));
    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 right = normalize(cross(up, N));
    up = cross(N, right);

    // Cosine-weighted hemisphere integral; a blurred mip of the source avoids sparkles from the sun.
    const float delta = 0.05;
    vec3 sum = vec3(0.0);
    float count = 0.0;
    for (float phi = 0.0; phi < 2.0 * PI; phi += delta) {
        for (float theta = 0.0; theta < 0.5 * PI; theta += delta) {
            vec3 t = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
            vec3 dir = t.x * right + t.y * up + t.z * N;
            sum += textureLod(uEnv, dir, 3.0).rgb * cos(theta) * sin(theta);
            count += 1.0;
        }
    }
    imageStore(uOut, ivec3(id), vec4(PI * sum / count, 1.0));
}
